\newcommand{\crucible}{\href{https://github.com/kilnware-dev/Crucible}{Crucible}}

\newcommand{\rutile}{\href{https://github.com/kilnware-dev/Rutile}{Rutile}}

\newcommand{\cinnabar}{\href{https://github.com/kilnware-dev/Cinnabar}{Cinnabar}}

