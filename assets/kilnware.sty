% Environments
% ==============================================================================

\newenvironment{termlist}
{
    \begin{list}{}{
        \setlength{\leftmargin}{0em}
        \setlength{\parsep}{0em}
        \setlength{\itemsep}{-0.5em}
        \setlength{\topsep}{0em}
    }
}
{
    \end{list}
}



% ==========================================
% EBNF Grammar Notation
% ==========================================

\usepackage{xcolor}
\usepackage{array}

% --- Colors ---
\definecolor{ebnf-nonterminal}{RGB}{55,75,110}
\definecolor{ebnf-terminal}{RGB}{45,45,45}

% --- Symbols ---

% Nonterminal: <expression>
\newcommand{\ebnfNonterm}[1]{%
  \ensuremath{\langle\text{\textit{#1}}\rangle}%
}

% Terminal: +
\newcommand{\ebnfTerm}[1]{%
  \ensuremath{\text{\textcolor{ebnf-terminal}{#1}}}%
}

% String literal: "hello"
\newcommand{\ebnfString}[1]{%
  \texttt{``#1''}%
}

% Token: IDENTIFIER
\newcommand{\ebnfToken}[1]{%
  \textsc{#1}%
}

% --- Operators ---

\newcommand{\ebnfAlt}{\ensuremath{\mid}}
\newcommand{\ebnfOptional}[1]{\ensuremath{[#1]}}
\newcommand{\ebnfRepeat}[1]{\ensuremath{\{#1\}}}
\newcommand{\ebnfGroup}[1]{\ensuremath{(#1)}}
\newcommand{\ebnfEmpty}{\ensuremath{\varepsilon}}
\newcommand{\ebnfProduces}{\ensuremath{::=}}

% --- Environment ---

\newenvironment{ebnf}{%
  \begin{quote}
  \small
  \renewcommand{\arraystretch}{1.35}
  \begin{tabular}{
    @{}>{\raggedleft\arraybackslash}p{0.28\linewidth}
    @{\quad}c@{\quad}
    >{\raggedright\arraybackslash}p{0.58\linewidth}@{}
  }
}{%
  \end{tabular}
  \end{quote}
}

% --- Production definition ---

\newcommand{\ebnfProduction}[2]{%
  \ebnfNonterm{#1} & \ebnfProduces & #2
}

\newcommand{\ebnfAlternative}{%
  \\ & \ebnfAlt &
}
