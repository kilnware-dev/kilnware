
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kilnware}[2026/11/24 Kilnware document style]

% ==============================================================================
% Dependencies
% ==============================================================================

\RequirePackage{geometry}
\RequirePackage{titlesec}
\RequirePackage{eqparbox}
\RequirePackage{chngcntr}
\RequirePackage{hyperref}
\RequirePackage{xparse}
\RequirePackage{tocloft}
\RequirePackage{amsmath}
\RequirePackage{xcolor}
\RequirePackage{array}


% ==============================================================================
% Heading Numbering
% ==============================================================================

\setcounter{secnumdepth}{3}

\renewcommand{\thesection}{%
    \thechapter.\arabic{section}%
}

\renewcommand{\thesubsection}{%
    \thesection.\arabic{subsection}%
}

\renewcommand{\thesubsubsection}{%
    \thesubsection.\arabic{subsubsection}%
}

% ==============================================================================
% Table of Contents Alignment
% ==============================================================================

\newlength{\tocnumwidth}
\setlength{\tocnumwidth}{2.5em}

\cftsetindents{chapter}{-\tocnumwidth}{\tocnumwidth}
\cftsetindents{section}{-1em}{\tocnumwidth}
\cftsetindents{subsection}{0.5em}{\tocnumwidth}
\cftsetindents{subsubsection}{2em}{\tocnumwidth}

% ==============================================================================
% Page Layout
% ==============================================================================

\geometry{
    a4paper,
    left=2.5cm,
    right=2.5cm,
    top=1.5cm,
    bottom=1.5cm
}

% ==============================================================================
% Paragraph Typography
% ==============================================================================

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.25em}

% ==============================================================================
% Configurable Settings
% ==============================================================================

% General numbering
\newlength{\marginnumsep}
\setlength{\marginnumsep}{12pt}

% Heading numbering
\newlength{\headingnumsep}
\setlength{\headingnumsep}{\marginnumsep}

% Subparagraph spacing
\newlength{\subparadashindent}
\setlength{\subparadashindent}{0pt}

\newlength{\subparadashsep}
\setlength{\subparadashsep}{0.8em}

% Labeled paragraph formatting
\newcommand{\paralabelpunct}{:}

\newlength{\paralabelpresep}
\setlength{\paralabelpresep}{0.4em}

\newlength{\paralabelpostsep}
\setlength{\paralabelpostsep}{0.6em}

% ==============================================================================
% Paragraph Counters
% ==============================================================================

% Paragraph counter resets at each subsection.
\newcounter{stdpara}[subsection]

% Subparagraph counter resets at each paragraph.
\newcounter{stdsubpara}[stdpara]

% Paragraph.subparagraph numbering
\renewcommand{\thestdsubpara}{%
    \arabic{stdpara}.\arabic{stdsubpara}%
}

% Labeled paragraph group counter
\newcounter{paralabelgroup}

% ==============================================================================
% Heading Spacing
% ==============================================================================

\titlespacing*{\subsection}
    {0pt}   % Left indentation
    {0.6em} % Space before
    {0.1em} % Space after

% ==============================================================================
% Internal Helpers
% ==============================================================================

% Width of the em dash used in subparagraphs
\newlength{\subparadashwidth}

\AtBeginDocument{%
    \settowidth{\subparadashwidth}{---}%
}

% ==============================================================================
% Introduction
% ==============================================================================

\NewDocumentCommand{\introduction}{}{%
    \chapter*{Introduction}%
    \thispagestyle{empty}%
}

% ==============================================================================
% Table of Contents
% ==============================================================================

\makeatletter

\renewcommand{\tableofcontents}{%
    \chapter*{\contentsname
        \@mkboth{\MakeUppercase\contentsname}
                {\MakeUppercase\contentsname}}%
    \@starttoc{toc}%
}

\makeatother

% ==============================================================================
% Standard Paragraph
% ==============================================================================

\NewDocumentCommand{\para}{o}{%
    \par\vspace{0.25em}%
    \noindent
    \refstepcounter{stdpara}%
    \makebox[0pt][r]{%
        \raisebox{0.35ex}{\scriptsize\arabic{stdpara}}%
        \hspace{\marginnumsep}%
    }%
    \IfValueTF{#1}{%
        \eqmakebox[plg-\theparalabelgroup][l]{%
            #1%
            \hspace{\paralabelpresep}%
            \hfill
            \paralabelpunct
        }%
        \hspace{\paralabelpostsep}%
        \hangindent=\dimexpr
            \eqboxwidth{plg-\theparalabelgroup}
            + \paralabelpostsep
        \relax
        \hangafter=1
    }{%
        \stepcounter{paralabelgroup}%
    }%
    \ignorespaces
}

% ==============================================================================
% Standard Subparagraph
% ==============================================================================

\NewDocumentCommand{\subpara}{o}{%
    \par\vspace{0.1em}%
    \noindent
    \refstepcounter{stdsubpara}%
    \makebox[0pt][r]{%
        \footnotesize(\thestdsubpara)%
        \hspace{\marginnumsep}%
    }%
    ---%
    \hspace{\subparadashsep}%
    \IfValueTF{#1}{%
        \eqmakebox[plg-\theparalabelgroup][l]{%
            #1%
            \hspace{\paralabelpresep}%
            \hfill
            \paralabelpunct
        }%
        \hspace{\paralabelpostsep}%
        \hangindent=\dimexpr
            \subparadashwidth
            + \subparadashsep
            + \eqboxwidth{plg-\theparalabelgroup}
            + \paralabelpostsep
        \relax
        \hangafter=1
    }{%
        \hangindent=\dimexpr
            \subparadashwidth
            + \subparadashsep
        \relax
        \hangafter=1
    }%
    \ignorespaces
}



% Nonterminal: italic text with clean hyphen breaks
\newcommand{\nt}[1]{\textit{#1}}

% Terminal: monospace token/keyword/symbol
\newcommand{\term}[1]{\texttt{#1}}

% Optional marker
\newcommand{\opt}{_{\mathrm{opt}}}

% Grammar block environment
\newenvironment{cgrammar}{%
  \begin{quote}\small\begin{tabular}{@{}r@{\quad:\quad}l@{}}%
}{%
  \end{tabular}\end{quote}%
}
