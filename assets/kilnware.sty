\newcommand{\ebnfdef}[2]{\par\noindent\textbf{#1}\ =\ #2;}
\newcommand{\ebnfterm}[1]{\texttt{#1}}
\newcommand{\ebnfstr}[1]{\texttt{"#1"}}
\newcommand{\ebnfstrsingle}[1]{\texttt{'#1'}}
\newcommand{\ebnfid}[1]{\textit{#1}}

